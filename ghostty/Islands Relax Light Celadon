# Islands Relax Light Celadon
#
# A Ghostty port of Panxiaoan's Islands Relax Light Celadon theme.
# Source palette: falcon-jetbrains-themes commit
# a6743fb34c96553f3f278a48de3e067e0eb766f7

# Core colors
background = #e4ecef
foreground = #383a42

# Cursor and selection
cursor-color = #067d17
cursor-text = #fafeff
selection-background = #afdbb8
selection-foreground = #383a42

# Search
search-background = #f6d4c8
search-foreground = #383a42
search-selected-background = #fde8b1
search-selected-foreground = #383a42

# Splits and Linux titlebar
split-divider-color = #70a6ae
window-theme = ghostty
window-titlebar-background = #c4dee4
window-titlebar-foreground = #1a536e

